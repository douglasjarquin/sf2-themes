---
const { eyebrow, title } = Astro.props;
---

<section class="route-placeholder">
  <div class="site-frame route-placeholder__inner">
    <p class="route-placeholder__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="route-placeholder__copy">
      Route content is entering the arena. The shared arcade shell is ready.
    </p>
  </div>
</section>
