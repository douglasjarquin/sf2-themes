---
import { readFileSync } from "node:fs";

import { paletteVariants } from "../../data/theme-data.mjs";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { sitePath } from "../../lib/site-path.mjs";

type ScreenshotManifest = {
  readonly viewport: { readonly width: number; readonly height: number };
  readonly entries: readonly ScreenshotEntry[];
};
type ScreenshotEntry = {
  readonly id: string;
  readonly name: string;
  readonly image: string;
  readonly moment: string;
  readonly width: number;
  readonly height: number;
};

function requiredString(value: unknown, label: string): string {
  if (typeof value !== "string" || value.length === 0) throw new TypeError(`${label} must be a non-empty string`);
  return value;
}

function requiredDimension(value: unknown, label: string): number {
  if (typeof value !== "number" || !Number.isSafeInteger(value) || value <= 0) throw new TypeError(`${label} must be a positive integer`);
  return value;
}

const manifestUrl = new URL("../../../public/screenshots/manifest.json", import.meta.url);
const parsedManifest: unknown = JSON.parse(readFileSync(manifestUrl, "utf8"));
if (typeof parsedManifest !== "object" || parsedManifest === null || Array.isArray(parsedManifest)) {
  throw new TypeError("Screenshot manifest must be an object");
}
const parsedViewport: unknown = Reflect.get(parsedManifest, "viewport");
const parsedEntries: unknown = Reflect.get(parsedManifest, "entries");
if (typeof parsedViewport !== "object" || parsedViewport === null || Array.isArray(parsedViewport)) {
  throw new TypeError("Screenshot manifest viewport is missing");
}
const viewportWidth = requiredDimension(Reflect.get(parsedViewport, "width"), "Screenshot manifest viewport width");
const viewportHeight = requiredDimension(Reflect.get(parsedViewport, "height"), "Screenshot manifest viewport height");
if (!Array.isArray(parsedEntries) || parsedEntries.length !== paletteVariants.length) {
  throw new TypeError(`Screenshot manifest must contain ${paletteVariants.length} entries`);
}
const manifestEntries: ScreenshotEntry[] = parsedEntries.map((entry, index) => {
  if (typeof entry !== "object" || entry === null || Array.isArray(entry)) {
    throw new TypeError(`Screenshot manifest entry ${index} is invalid`);
  }
  const id = requiredString(Reflect.get(entry, "id"), `Screenshot manifest entry ${index} id`);
  const name = requiredString(Reflect.get(entry, "name"), `Screenshot manifest entry ${index} name`);
  const image = requiredString(Reflect.get(entry, "image"), `Screenshot manifest entry ${index} image`);
  const moment = requiredString(Reflect.get(entry, "moment"), `Screenshot manifest entry ${index} moment`);
  const width = requiredDimension(Reflect.get(entry, "width"), `Screenshot manifest entry ${index} width`);
  const height = requiredDimension(Reflect.get(entry, "height"), `Screenshot manifest entry ${index} height`);
  return { id, name, image, moment, width, height };
});
for (const [index, variant] of paletteVariants.entries()) {
  const entry = manifestEntries[index];
  if (entry?.id !== variant.id || entry.image !== `game/${variant.id}.png`) {
    throw new TypeError(`Screenshot manifest is missing canonical theme ${variant.id}`);
  }
}
const manifest: ScreenshotManifest = {
  viewport: { width: viewportWidth, height: viewportHeight },
  entries: manifestEntries,
};
const screenshotBase = sitePath("screenshots");
---

<SiteLayout title="Screenshots" description="Standard captures of every playable sf2-themes cabinet fighter.">
  <section class="screenshots-page">
    <header class="screenshots-hero site-frame">
      <p class="screenshots-eyebrow">ASCII CABINET ARCHIVE</p>
      <h1>SCREENSHOT LIBRARY</h1>
      <p>
        Thirty-six standard captures from the playable cabinet, one for every palette variant. Each image is{" "}
        {manifest.viewport.width} × {manifest.viewport.height} pixels and preserves a different moment
        from the round.
      </p>
    </header>

    <section class="screenshots-grid site-frame" aria-label="ASCII cabinet screenshots">
      {
        manifest.entries.map((screenshot) => (
          <article
            class="screenshot-card"
            data-screenshot-card
            data-screenshot-id={screenshot.id}
          >
            <figure>
              <div class="screenshot-card__image-wrap">
                <img
                  alt={`${screenshot.name} gameplay capture in the ASCII fighting game cabinet`}
                  data-screenshot-image
                  height={screenshot.height}
                  loading="lazy"
                  src={`${screenshotBase}${screenshot.image}`}
                  width={screenshot.width}
                />
              </div>
              <figcaption>
                <span class="screenshot-card__fighter">{screenshot.name}</span>
                <span class="screenshot-card__moment">FRAME: {screenshot.moment.toUpperCase()}</span>
              </figcaption>
            </figure>
          </article>
        ))
      }
    </section>
  </section>
</SiteLayout>

<style>
  .screenshots-page { padding-block: var(--space-12) var(--space-20); }
  .screenshots-hero { display: grid; gap: var(--space-4); padding-block-end: var(--space-8); }
  .screenshots-eyebrow { margin: 0; color: var(--color-cyan); font-family: var(--font-display); font-size: var(--text-overline); line-height: 1.9; }
  .screenshots-hero h1 { margin: 0; color: var(--color-accent); font-family: var(--font-display); font-size: var(--text-display); line-height: 1.5; text-shadow: 4px 4px 0 var(--color-red); }
  .screenshots-hero > p:last-child { max-inline-size: 64ch; margin: 0; color: color-mix(in srgb, var(--color-foreground) 72%, transparent); font-size: var(--text-body-lg); line-height: 1.7; }
  .screenshots-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); border-block-start: var(--border-strong) solid color-mix(in srgb, var(--color-foreground) 8%, transparent); padding-block-start: var(--space-8); }
  .screenshot-card { min-inline-size: 0; border: var(--border-strong) solid color-mix(in srgb, var(--color-foreground) 14%, transparent); background: var(--color-panel); box-shadow: var(--shadow-card) var(--shadow-card) 0 color-mix(in srgb, var(--color-background) 70%, black); }
  .screenshot-card figure { display: grid; gap: 0; margin: 0; }
  .screenshot-card__image-wrap { overflow: hidden; background: var(--color-background); }
  .screenshot-card img { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .screenshot-card figcaption { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-4); border-block-start: var(--border-strong) solid color-mix(in srgb, var(--color-foreground) 12%, transparent); }
  .screenshot-card__fighter { color: var(--color-accent); font-family: var(--font-display); font-size: var(--text-label); line-height: 1.8; }
  .screenshot-card__moment { color: var(--color-cyan); font-family: var(--font-mono); font-size: var(--text-caption); line-height: 1.5; }
  @media (max-width: 620px) { .screenshots-page { padding-block-start: calc(var(--space-12) + var(--space-1)); } .screenshots-grid { grid-template-columns: 1fr; gap: var(--space-6); padding-block-start: var(--space-6); } .screenshot-card figcaption { align-items: start; flex-direction: column; } }
</style>
