---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../lib/site-path.mjs";

const recoveryLinks = [
  { label: "home", href: sitePath() },
  { label: "install", href: `${sitePath()}#install` },
  { label: "ports", href: `${sitePath()}#ports` },
];
---

<SiteLayout
  description="This path is not part of the sf2-themes site. Choose a known route or open the GitHub repository."
  noindex
  title="Page not found"
>
  <section class="missing-page" data-testid="project-404">
    <h1 class="missing-page__kicker"><span class="hp" aria-hidden="true"># </span>Round over.</h1>
    <p class="missing-page__lede">
      This URL is not a page in sf2-themes. Pick a known route or open the repository.
    </p>
    <nav aria-label="Known routes" class="missing-page__links">
      {
        recoveryLinks.map((item) => (
          <a href={item.href}>❯ {item.label}</a>
        ))
      }
      <a href="https://github.com/douglasjarquin/sf2-themes" rel="noreferrer" target="_blank">
        ❯ github repository <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </section>
</SiteLayout>

<style>
  .missing-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px 40px;
  }

  .missing-page__kicker {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
  }

  .hp {
    color: var(--muted);
    font-weight: 400;
  }

  .missing-page__lede {
    max-inline-size: 62ch;
    margin: 14px 0 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .missing-page__links {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-8);
  }

  .missing-page__links a {
    color: var(--accent);
    padding: var(--space-1) 0;
  }

  .missing-page__links a:hover {
    color: var(--fg);
  }
</style>
