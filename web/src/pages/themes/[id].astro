---
import RedirectStub from "../../components/RedirectStub.astro";
import { siteThemeFamilies } from "../../data/site-theme-data.mjs";
import { sitePath } from "../../lib/site-path.mjs";

export function getStaticPaths() {
  return siteThemeFamilies.map(({ id }) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<RedirectStub target={`${sitePath()}?theme=${id}`} />
