---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { sitePath } from "../../lib/site-path.mjs";
import { themeFamilies } from "../../data/site-theme-data.mjs";

const cards = themeFamilies.map((theme, index) => ({
  id: theme.id,
  name: theme.name,
  world: theme.world,
  number: String(index + 1).padStart(2, "0"),
  href: sitePath(`themes/${theme.id}`),
  dark: theme.dark,
  light: theme.light,
}));
---

<SiteLayout
  title="The roster - 18 theme families"
  description="Browse all 18 Street Fighter II theme families, each with dark and light modes for WezTerm, Herdr, Neovim, Codex, and Starship."
>
  <div class="roster-page">
    <section class="roster-hero site-frame" aria-labelledby="roster-title">
      <p class="roster-eyebrow">18 FAMILIES / 36 MODES / TOML-BACKED</p>
      <h1 id="roster-title" class="page-title">CHOOSE YOUR FIGHTER.</h1>
      <p class="roster-lede">
        Every fighter gets a real palette - its own neutral ramp, accents, and a complete ANSI set in dark and light.
        Pick one to wear it sitewide, or open its page for the full breakdown.
      </p>
    </section>

    <section class="roster-grid site-frame" aria-label="Theme families">
      {
        cards.map((card) => (
          <article
            class="theme-card"
            data-theme-card={card.id}
            data-wearing={card.id === "main" ? "true" : undefined}
            style={`--dark-bg: ${card.dark.ui.background}; --dark-surface: ${card.dark.ui.surface0}; --dark-overlay: ${card.dark.ui.surface1}; --dark-muted: ${card.dark.ui.subtext}; --dark-fg: ${card.dark.ui.foreground}; --dark-accent: ${card.dark.ui.accent}; --dark-secondary: ${card.dark.semantic.red}; --dark-s1: ${card.dark.ansi.normal.red}; --dark-s2: ${card.dark.ansi.normal.green}; --dark-s3: ${card.dark.ansi.normal.blue}; --dark-s4: ${card.dark.ansi.normal.magenta}; --light-bg: ${card.light.ui.background}; --light-surface: ${card.light.ui.surface0}; --light-overlay: ${card.light.ui.surface1}; --light-muted: ${card.light.ui.subtext}; --light-fg: ${card.light.ui.foreground}; --light-accent: ${card.light.ui.accent}; --light-secondary: ${card.light.semantic.red}; --light-s1: ${card.light.ansi.normal.red}; --light-s2: ${card.light.ansi.normal.green}; --light-s3: ${card.light.ansi.normal.blue}; --light-s4: ${card.light.ansi.normal.magenta}`}
          >
            <div class="theme-card__meta">
              <span>{card.number} / FAMILY</span>
              <span data-theme-card-tag>2 MODES</span>
            </div>
            <a class="theme-card__detail" data-theme-detail href={card.href}>
              <h2>{card.name}</h2>
              <p>{card.world}</p>
              <div class="theme-card__swatches" aria-label={`${card.name} palette preview`}>
                <span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
              <span class="theme-card__link">FULL PALETTE <span aria-hidden="true">→</span></span>
            </a>
            <button class="theme-card__set" data-set-theme data-theme-id={card.id} type="button">SET THEME</button>
          </article>
        ))
      }
    </section>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const update = (event) => {
      const { id } = event.detail;
      for (const card of document.querySelectorAll("[data-theme-card]")) {
        const selected = card.dataset.themeCard === id;
        card.dataset.wearing = String(selected);
        const tag = card.querySelector("[data-theme-card-tag]");
        const button = card.querySelector("[data-set-theme]");
        if (tag) tag.textContent = selected ? "WEARING" : "2 MODES";
        if (button) button.textContent = selected ? "ACTIVE" : "SET THEME";
      }
    };
    for (const button of document.querySelectorAll("[data-set-theme]")) {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        window.dispatchEvent(new CustomEvent("sf2-theme-request", { detail: { id: button.dataset.themeId } }));
      });
    }
    window.addEventListener("sf2-theme-request", (event) => {
      window.sf2ApplySiteTheme?.(event.detail.id, document.documentElement.dataset.siteMode || "dark");
    });
    window.addEventListener("sf2-theme", update);
    update({ detail: { id: document.documentElement.dataset.siteTheme || "main" } });
  })();
</script>

<style>
  .roster-page { padding-block-end: var(--space-20); }
  .roster-hero { padding-block: var(--space-20) var(--space-12); }
  .roster-eyebrow { margin: 0 0 var(--space-6); color: var(--ac); font: 600 var(--text-overline)/1.4 var(--font-mono); letter-spacing: 0.22em; }
  .roster-lede { max-inline-size: 720px; margin: var(--space-8) 0 0; color: var(--mu); font-size: var(--text-body-lg); font-weight: 500; line-height: 1.5; text-wrap: pretty; }
  .roster-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr)); gap: var(--space-5); }
  .theme-card { display: grid; grid-template-columns: 1fr auto; gap: var(--space-3) var(--space-4); padding: var(--space-8); border: var(--border-thin) solid var(--card-overlay, var(--dark-overlay)); border-radius: var(--radius-panel); background: var(--card-bg, var(--dark-bg)); color: var(--card-fg, var(--dark-fg)); transition: border-color var(--duration-micro) ease-out, transform var(--duration-micro) ease-out; }
  :root[data-site-mode="dark"] .theme-card { --card-bg: var(--dark-bg); --card-surface: var(--dark-surface); --card-overlay: var(--dark-overlay); --card-muted: var(--dark-muted); --card-fg: var(--dark-fg); --card-accent: var(--dark-accent); --card-secondary: var(--dark-secondary); --card-s1: var(--dark-s1); --card-s2: var(--dark-s2); --card-s3: var(--dark-s3); --card-s4: var(--dark-s4); }
  :root[data-site-mode="light"] .theme-card { --card-bg: var(--light-bg); --card-surface: var(--light-surface); --card-overlay: var(--light-overlay); --card-muted: var(--light-muted); --card-fg: var(--light-fg); --card-accent: var(--light-accent); --card-secondary: var(--light-secondary); --card-s1: var(--light-s1); --card-s2: var(--light-s2); --card-s3: var(--light-s3); --card-s4: var(--light-s4); }
  .theme-card:hover, .theme-card[data-wearing="true"] { border-color: var(--card-accent); transform: translateY(-2px); }
  .theme-card__meta { display: flex; grid-column: 1 / -1; justify-content: space-between; gap: var(--space-3); color: var(--card-muted); font: 600 14px/1.4 var(--font-mono); letter-spacing: 0.16em; }
  .theme-card__meta span:last-child { color: var(--card-accent); }
  .theme-card__detail { display: block; min-inline-size: 0; grid-column: 1 / -1; color: var(--card-fg); }
  .theme-card__detail:hover { color: var(--card-fg); }
  .theme-card h2 { margin: var(--space-6) 0 var(--space-2); font-size: 44px; line-height: 1; }
  .theme-card p { margin: 0 0 var(--space-6); color: var(--card-muted); font-size: 18px; }
  .theme-card__swatches { display: flex; gap: 6px; margin-block-end: var(--space-6); }
  .theme-card__swatches span { flex: 1; min-inline-size: 0; block-size: 34px; border-radius: 5px; background: var(--card-s1); }
  .theme-card__swatches span:first-child { flex: 2; background: var(--card-accent); }
  .theme-card__swatches span:nth-child(2) { background: var(--card-secondary); }
  .theme-card__swatches span:nth-child(3) { background: var(--card-s2); }
  .theme-card__swatches span:nth-child(4) { background: var(--card-s3); }
  .theme-card__swatches span:nth-child(5) { background: var(--card-s4); }
  .theme-card__swatches span:nth-child(6) { background: var(--card-fg); }
  .theme-card__link { color: var(--card-accent); font: 600 15px/1.4 var(--font-mono); letter-spacing: 0.08em; }
  .theme-card__set { justify-self: end; align-self: end; min-block-size: 44px; padding: var(--space-2) var(--space-4); border: var(--border-thin) solid var(--card-overlay); border-radius: var(--radius-control); background: transparent; color: var(--card-muted); font: 600 13px/1.4 var(--font-mono); letter-spacing: 0.08em; cursor: pointer; }
  .theme-card__set:hover, .theme-card__set:focus-visible { border-color: var(--card-accent); color: var(--card-accent); }
  @media (max-width: 640px) { .roster-hero { padding-block: var(--space-12) var(--space-10); } .theme-card { padding: var(--space-6); } .theme-card h2 { font-size: clamp(36px, 12vw, 44px); } .theme-card__set { grid-column: 1 / -1; justify-self: start; } }
  @media (prefers-reduced-motion: reduce) { .theme-card { transition: none; } }
</style>
