---
import FeaturedPalettePreview from "../components/FeaturedPalettePreview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { PRODUCT_DESCRIPTION } from "../lib/seo.mjs";
import { sitePath } from "../lib/site-path.mjs";


---

<SiteLayout
  title="Street Fighter II terminal themes"
  description={PRODUCT_DESCRIPTION}
>
  <div class="home-page">
    <section class="home-hero site-frame" aria-labelledby="home-heading">
      <div class="home-hero__copy">
        <p class="home-kicker">ROUND ONE — TERMINAL EDITION</p>
        <h1 id="home-heading">Fight for your terminal.</h1>
        <p class="home-lede">
          A complete Street Fighter II color pack for WezTerm, Herdr, Neovim, Codex, and Starship,
          tuned from the arcade floor to your command line.
        </p>
        <div class="home-actions">
          <a class="home-action home-action--primary" href={sitePath("themes")}>VIEW THE ROSTER</a>
          <a class="home-action" href={sitePath("install")}>INSTALL THE PACK</a>
        </div>
      </div>
    </section>

    <FeaturedPalettePreview />

    <section class="home-values site-frame" aria-label="Pack highlights">
      <article>
        <span>36</span>
        <h2>FULLY RESOLVED THEMES</h2>
        <p>Dark and light main variants plus the Super Street Fighter II Turbo roster.</p>
      </article>
      <article>
        <span>05</span>
        <h2>SUPPORTED TERMINALS</h2>
        <p>Install a matching palette in WezTerm, Herdr, Neovim, Codex, or Starship with the same command.</p>
      </article>
      <article>
        <span>00</span>
        <h2>RUNTIME DEPENDENCIES</h2>
        <p>The standalone CLI needs Python 3.11 or newer and nothing else.</p>
      </article>
    </section>
  </div>
</SiteLayout>

<style>
  .home-page { display: flex; flex-direction: column; padding-block-end: var(--space-20); }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; padding-block: var(--space-20) 0; }
  .home-hero__copy { display: grid; gap: var(--space-6); max-inline-size: 62ch; }
  .home-kicker { margin: 0; color: var(--ac); font: 600 var(--text-overline)/1.4 var(--font-mono); letter-spacing: 0.22em; }
  h1, h2 { margin: 0; font-family: var(--font-display); line-height: 0.95; text-transform: uppercase; }
  .home-hero h1 { max-inline-size: 100%; color: var(--fg); font-size: var(--text-hero); letter-spacing: -.02em; text-wrap: balance; }
  h2 { color: var(--fg); font-size: var(--text-section); }
  .home-lede { max-inline-size: 760px; margin: 0; color: var(--mu); font-size: var(--text-body-lg); line-height: 1.5; }
  .home-actions { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .home-action { min-block-size: 60px; border: var(--border-thin) solid var(--ov); border-radius: 8px; color: var(--fg); font: 600 18px/1.4 var(--font-mono); letter-spacing: 0.08em; padding: var(--space-5) var(--space-8); }
  .home-action:hover { border-color: var(--ac); color: var(--ac); transform: translateY(-2px); }
  .home-action--primary { border-color: var(--ac); background: var(--ac); color: var(--bg); }
  .home-action--primary:hover { color: var(--bg); filter: brightness(1.1); }
  .home-values { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); padding-block: 0 110px; }
  .home-values article { padding: var(--space-9); border: var(--border-thin) solid var(--ov); border-radius: var(--radius-panel); }
  .home-values span { color: var(--ac); font-family: var(--font-display); font-size: 96px; line-height: 1; }
  .home-values h2 { margin-block: var(--space-4) var(--space-3); font-family: var(--font-body); font-size: 26px; line-height: 1.15; letter-spacing: 0.04em; }
  .home-values p { max-inline-size: 32ch; margin: 0; color: var(--mu); font-size: 19px; line-height: 1.55; }
  @media (max-width: 760px) { .home-hero { padding-block: var(--space-12) 0; } .home-hero__copy { gap: var(--space-5); } .home-hero .home-kicker { max-inline-size: 28ch; } .home-hero h1 { font-size: clamp(52px, 15vw, 164px); } .home-action { inline-size: 100%; } .home-values { grid-template-columns: 1fr; padding-block-end: var(--space-15); } .home-values span { font-size: var(--text-stat-mobile); } }
  @media (prefers-reduced-motion: reduce) { .home-action { transition: none; } }
</style>
