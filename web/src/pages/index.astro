---
import FeaturedPalettePreview from "../components/FeaturedPalettePreview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { PRODUCT_DESCRIPTION } from "../lib/seo.mjs";
import { sitePath } from "../lib/site-path.mjs";

---

<SiteLayout
  title="Street Fighter II terminal themes"
  description={PRODUCT_DESCRIPTION}
>
  <div class="home-page">
    <section class="home-hero site-frame" aria-labelledby="home-heading">
      <div class="home-hero__copy">
        <p class="home-kicker">ROUND ONE - TERMINAL EDITION</p>
        <h1 id="home-heading">Fight for your terminal.</h1>
        <p class="home-lede">
          A complete Street Fighter II color pack for WezTerm, Herdr, Neovim, Codex, and Starship,
          tuned from the arcade floor to your command line.
        </p>
        <div class="home-actions">
          <a class="home-action home-action--primary" href={sitePath("themes")}>VIEW THE ROSTER</a>
          <a class="home-action" href={sitePath("install")}>INSTALL THE PACK</a>
        </div>
      </div>

      <FeaturedPalettePreview />
    </section>

    <section class="home-menu site-frame" aria-labelledby="menu-heading">
      <div>
        <p class="home-kicker">CHOOSE YOUR MODE</p>
        <h2 id="menu-heading">MAKE THE CABINET YOURS</h2>
      </div>
      <nav aria-label="Explore sf2-themes" class="home-menu__links">
        <a href={sitePath("themes")}>01 / THEMES</a>
        <a href={sitePath("palette")}>02 / PALETTE</a>
        <a href={sitePath("install")}>03 / INSTALL</a>
      </nav>
    </section>

    <section class="home-values site-frame" aria-label="Pack highlights">
      <article>
        <span>36</span>
        <h2>FULLY RESOLVED THEMES</h2>
        <p>Dark and light main variants plus the Super Street Fighter II Turbo roster.</p>
      </article>
      <article>
        <span>05</span>
        <h2>SUPPORTED TERMINALS</h2>
        <p>Install a matching palette in WezTerm, Herdr, Neovim, Codex, or Starship with the same command.</p>
      </article>
      <article>
        <span>00</span>
        <h2>RUNTIME DEPENDENCIES</h2>
        <p>The standalone CLI needs Python 3.11 or newer and nothing else.</p>
      </article>
    </section>
  </div>
</SiteLayout>

<style>
  .home-page { display: flex; flex-direction: column; padding-block-end: var(--space-20); background-color: var(--color-background); background-image: radial-gradient(color-mix(in srgb, var(--color-foreground) 7%, transparent) 1px, transparent 1px); background-size: 22px 22px; }
  .home-hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: var(--space-8); padding-block: var(--space-15) calc(var(--space-15) * 2); }
  .home-hero__copy { display: grid; gap: var(--space-6); max-inline-size: 62ch; }
  .home-kicker { margin: 0; color: var(--color-cyan); font-family: var(--font-display); font-size: var(--text-overline); line-height: 1.9; }
  h1, h2 { margin: 0; font-family: var(--font-display); line-height: 1.5; }
  .home-hero h1 { color: var(--color-foreground); font-family: var(--font-body); font-size: var(--text-hero); font-weight: 700; letter-spacing: -.02em; line-height: 1.1; }
  h2 { color: var(--color-foreground); font-size: var(--text-section); }
  .home-lede { margin: 0; color: color-mix(in srgb, var(--color-foreground) 70%, transparent); font-size: var(--text-body-lg); line-height: 1.7; }
  .home-actions { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .home-action { border: var(--border-strong) solid var(--color-foreground); box-shadow: var(--shadow-card) var(--shadow-card) 0 var(--color-background); color: var(--color-foreground); font-family: var(--font-display); font-size: var(--text-overline); line-height: 1.5; padding: var(--space-3) var(--space-4); }
  .home-action:hover { background: var(--color-foreground); color: var(--color-background); transform: translate(2px, 2px); }
  .home-action--primary { border-color: var(--color-red); background: var(--color-red); color: var(--color-foreground); }
  .home-menu { order: 3; display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, .8fr); gap: var(--space-8); margin-block-start: var(--space-15); padding-block: var(--space-10); border-block-start: 2px solid color-mix(in srgb, var(--color-foreground) 8%, transparent); }
  .home-menu__links { display: grid; gap: var(--space-3); align-content: center; }
  .home-menu__links a { border-inline-start: var(--border-strong) solid var(--color-red); color: var(--color-foreground); font-family: var(--font-display); font-size: var(--text-label); line-height: 1.6; padding: var(--space-3) var(--space-4); }
  .home-menu__links a:hover { border-color: var(--color-gold); background: var(--color-panel); color: var(--color-gold); transform: translateX(3px); }
  .home-values { order: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-10); padding-block: var(--space-15); border-block-start: 2px solid color-mix(in srgb, var(--color-foreground) 8%, transparent); }
  .home-values article { padding: 0; }
  .home-values span { color: var(--color-red); font-family: var(--font-display); font-size: var(--text-section); }
  .home-values h2 { margin-block: var(--space-4) var(--space-3); font-size: var(--text-caption); }
  .home-values p { margin: 0; color: color-mix(in srgb, var(--color-foreground) 64%, transparent); font-size: var(--text-body); line-height: 1.65; }
  @media (max-width: 760px) { .home-hero { grid-template-columns: 1fr; gap: var(--space-20); padding-block: var(--space-15) var(--space-20); } .home-hero__copy { gap: var(--space-5); } .home-hero .home-kicker { max-inline-size: 28ch; } .home-menu { grid-template-columns: 1fr; } .home-values { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .home-action, .home-menu__links a { transition: none; } }
</style>
