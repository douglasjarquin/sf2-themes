---
import SiteLayout from "../../layouts/SiteLayout.astro";

const installScript = `git clone https://github.com/douglasjarquin/sf2-themes.git
cd sf2-themes
install -m 755 sf2-themes "$HOME/.local/bin/sf2-themes"`;

const moves = [
  ["WEZTERM", "sf2-themes setup wezterm", "Set up the one-time WezTerm integration."],
  ["WEZTERM", "sf2-themes apply wezterm --theme ryu", "Apply Ryu, or replace the theme name with your fighter."],
  ["HERDR", "sf2-themes setup herdr", "Set up the one-time Herdr integration."],
  ["HERDR", "sf2-themes apply herdr --theme chun-li", "Apply Chun-Li, then reload the Herdr server configuration."],
  ["NVIM", "sf2-themes setup nvim", "Set up the one-time Neovim colorscheme loader."],
  ["NVIM", "sf2-themes apply nvim --theme ryu-light", "Apply Ryu Light, or replace the theme name with your fighter."],
  ["CODEX", "sf2-themes setup codex", "Set up the one-time Codex custom theme directory."],
  ["CODEX", "sf2-themes apply codex --theme ryu-light", "Apply Ryu Light, then restart Codex or reselect it with /theme."],
];
---

<SiteLayout
  title="Install"
  description="Install sf2-themes, then set up and apply Street Fighter II terminal colors."
>
  <section class="install-page">
    <div class="site-frame install-page__inner">
      <header class="install-page__header">
        <p>READY PLAYER ONE</p>
        <h1>INSTALL</h1>
        <p class="install-page__lede">
          Clone the project, put the standalone CLI on your PATH, then set up each terminal once.
        </p>
      </header>

      <section aria-labelledby="install-script-heading" class="install-panel">
        <div class="install-panel__heading">
          <span class="install-panel__lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div>
            <p class="install-panel__eyebrow">TERMINAL</p>
            <h2 id="install-script-heading">GET THE CLI</h2>
          </div>
          <button data-install-copy data-install-script={installScript} type="button"
            >Copy install script</button
          >
        </div>
        <pre aria-label="Install script"><code>{installScript}</code></pre>
        <p class="install-panel__meta">Python 3.11 or newer. No package dependencies.</p>
      </section>

      <section aria-labelledby="move-list-heading" class="install-moves">
        <div class="install-moves__heading">
          <p>SETUP, THEN APPLY</p>
          <h2 id="move-list-heading">MAKE YOUR MOVE</h2>
        </div>
        <ol>
          {
            moves.map(([adapter, command, detail], index) => (
              <li>
                <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <p>{adapter}</p>
                  <code>{command}</code>
                  <small>{detail}</small>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <aside aria-labelledby="adapter-notes-heading" class="adapter-notes">
        <p>ADAPTER NOTES</p>
        <h2 id="adapter-notes-heading">NO GUESSWORK</h2>
        <ul>
          <li>
            WezTerm setup upgrades an existing assignment to the managed pointer. For another
            selected scheme, use <code>--adopt</code> or paste the printed snippet.
          </li>
          <li>
            Herdr leaves an unmarked <code>[theme]</code> section alone unless you use
            <code>--adopt</code>. After applying, run <code>herdr server reload-config</code>.
          </li>
          <li><code>install</code> remains a deprecated alias for <code>apply</code>.</li>
        </ul>
      </aside>
    </div>
  </section>
</SiteLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-install-copy]");

  copyButton?.addEventListener("click", async () => {
    const installScript = copyButton.dataset.installScript;

    if (!installScript || !navigator.clipboard?.writeText) return;

    try {
      await navigator.clipboard.writeText(installScript);
    } catch (error) {
      console.warn(
        "[sf2-themes] Clipboard write failed:",
        error instanceof Error ? error.name : "UnknownError",
      );
      return;
    }

    copyButton.textContent = "✓ Copied";
  });
</script>

<style>
  .install-page__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 1fr); align-items: start; gap: var(--space-12); padding-block: var(--space-12) var(--space-20); }
  .install-page__header, .adapter-notes { grid-column: 1 / -1; }
  .install-page__header { display: grid; gap: var(--space-4); max-inline-size: 760px; }
  .install-page__header > p:first-child { display: none; }
  .install-page__header > p:first-child, .install-panel__eyebrow, .install-moves__heading > p, .adapter-notes > p, .install-moves li > span { margin: 0; color: var(--color-cyan); font-family: var(--font-display); font-size: 9px; line-height: 1.9; }
  .install-moves li p { margin: 0; color: var(--color-cyan); font-family: var(--font-display); font-size: 14px; line-height: 1.45; }
  h1, h2 { margin: 0; color: var(--color-accent); font-family: var(--font-display); font-weight: 400; text-shadow: 4px 4px 0 var(--color-red); }
  h1 { font-size: 26px; line-height: 1.5; }
  h2 { font-size: clamp(16px, 3vw, 20px); line-height: 1.6; }
  .install-page__lede, .install-panel__meta, .install-moves small, .adapter-notes li { color: color-mix(in srgb, var(--color-foreground) 72%, transparent); font-size: 16px; line-height: 1.7; }
  .install-page__lede, .install-panel__meta { margin: 0; }
  .install-panel, .adapter-notes { border: 2px solid color-mix(in srgb, var(--color-foreground) 12%, transparent); background: color-mix(in srgb, var(--color-background) 82%, black); box-shadow: 6px 6px 0 color-mix(in srgb, var(--color-background) 72%, black); }
  .install-panel__heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: 54px; padding: var(--space-3) var(--space-4); border-block-end: 2px solid color-mix(in srgb, var(--color-foreground) 8%, transparent); }
  .install-panel__heading > div { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .install-panel__lights { display: flex; gap: 7px; }
  .install-panel__lights i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--color-red); }
  .install-panel__lights i:nth-child(2) { background: var(--color-accent); }
  .install-panel__lights i:nth-child(3) { background: var(--color-cyan); }
  button { min-block-size: 30px; padding: var(--space-2) var(--space-3); border: 1px solid color-mix(in srgb, var(--color-foreground) 24%, transparent); background: transparent; box-shadow: none; color: color-mix(in srgb, var(--color-foreground) 72%, transparent); cursor: pointer; font: 500 12px/1.2 var(--font-mono); transition: color var(--duration-micro) ease-out, border-color var(--duration-micro) ease-out; }
  button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  button:focus-visible { outline: 3px solid var(--color-cyan); outline-offset: 4px; }
  pre { min-block-size: 150px; min-inline-size: 0; overflow: hidden; margin: 0; padding: var(--space-5) var(--space-6); background: transparent; color: var(--color-foreground); font: 500 13px/2 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
  pre code { white-space: inherit; }
  .install-panel__meta { display: none; }
  .install-moves { display: grid; gap: var(--space-4); }
  .install-moves__heading { display: grid; gap: var(--space-2); }
  ol, ul { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .install-moves li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-3); padding: 0; }
  .install-moves li > div { display: grid; gap: var(--space-2); }
  code { overflow-wrap: anywhere; color: var(--color-foreground); font-family: var(--font-mono); font-size: 14px; }
  .install-moves small { font-size: 14px; line-height: 1.45; }
  .adapter-notes { padding: var(--space-6); }
  .adapter-notes h2 { margin-block: var(--space-2) var(--space-5); }
  .adapter-notes li { position: relative; padding-inline-start: var(--space-5); }
  .adapter-notes li::before { position: absolute; inset-inline-start: 0; color: var(--color-red); content: "▸"; }
  @media (min-width: 561px) { .install-page__header { margin-block-end: var(--space-6); } }
  @media (max-width: 560px) {
    .install-page__inner { grid-template-columns: 1fr; gap: var(--space-10); padding-block: calc(var(--space-12) + var(--space-1)) var(--space-15); }
    .install-page__header, .adapter-notes { grid-column: auto; }
    .install-page__header { margin-block-end: calc(var(--space-6) + var(--space-1)); }
    .install-panel__heading { flex-wrap: nowrap; }
    .install-panel__lights { flex: none; }
    button { max-inline-size: 190px; }
    pre { padding-inline: var(--space-5); font-size: 12px; }
  }
</style>
