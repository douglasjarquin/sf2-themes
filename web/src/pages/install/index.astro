---
import SiteLayout from "../../layouts/SiteLayout.astro";
const CLI = "uvx --from git+https://github.com/douglasjarquin/sf2-themes.git sf2-themes";
const installScript = `${CLI} --version`;
const moves = [
  ["WEZTERM", "setup wezterm", "Set up the one-time WezTerm integration."],
  ["WEZTERM", "apply wezterm --theme ryu", "Apply Ryu's dark and light schemes; WezTerm switches with host appearance."],
  ["HERDR", "setup herdr", "Set up the one-time Herdr integration."],
  ["HERDR", "apply herdr --theme chun-li", "Apply Chun-Li with Herdr auto-switch, then reload the server configuration."],
  ["NVIM", "setup nvim", "Set up the one-time Neovim colorscheme loader."],
  ["NVIM", "apply nvim --theme ryu-light", "Apply Ryu's dark and light colorschemes; Neovim follows TERM_THEME or background."],
  ["CODEX", "setup codex", "Set up the one-time Codex custom theme directory."],
  ["CODEX", "apply codex --theme ryu-light", "Apply Ryu Light, then restart Codex or reselect it with /theme."],
  ["CLAUDE", "setup claude", "Set up the one-time Claude Code custom theme directory."],
  ["CLAUDE", "apply claude --theme ryu-light", "Apply Ryu Light, then reselect it with /theme in Claude Code."],
  ["STARSHIP", "apply starship --theme vega", "Apply Vega to Starship and refresh the zsh-syntax highlight snippet."],
];
---

<SiteLayout title="Install Street Fighter II terminal themes" description="Install sf2-themes, then set up and apply Street Fighter II terminal colors.">
  <div class="install-page">
    <header class="install-hero site-frame">
      <p class="install-eyebrow">SETUP + APPLY</p>
      <h1 class="page-title">INSTALL</h1>
      <p class="install-lede">Run the CLI directly from GitHub with uv, then set up each terminal once. Use short catalog ids such as <code>ken</code> on the CLI; installed theme identities use the grouped <code>sf2-ken</code> form in every adapter.</p>
    </header>

    <div class="install-content site-frame">
      <section class="install-section" aria-labelledby="cli-heading">
        <h2 id="cli-heading">GET THE CLI</h2>
        <div class="command-bar">
          <code aria-label={installScript}><span class="command-prompt" aria-hidden="true">$</span> {installScript}</code>
          <button aria-label="Copy install script" data-install-copy data-install-script={installScript} type="button">COPY INSTALL SCRIPT</button>
        </div>
        <p class="install-muted">Requires uv and Python 3.11 or newer.</p>
        <p aria-live="polite" class="install-status" data-copy-status data-install-status role="status"></p>
      </section>

      <section class="install-section" aria-labelledby="moves-heading">
        <h2 id="moves-heading">MAKE YOUR MOVE</h2>
        <div class="install-moves">
          {
            moves.map(([adapter, args, note], index) => {
              const command = `${CLI} ${args}`;
              return (
                <article class="install-step" data-install-step>
                  <div class="install-step__meta">
                    <span>{String(index + 1).padStart(2, "0")} - {adapter}</span>
                    <button data-install-command={command} type="button">COPY</button>
                  </div>
                  <code>{command}</code>
                  <p>{note}</p>
                </article>
              );
            })
          }
        </div>
      </section>

      <section class="install-section install-notes" aria-labelledby="notes-heading">
        <h2 id="notes-heading">NO GUESSWORK</h2>
        <ul>
          <li>WezTerm setup upgrades an existing assignment to the managed pointer, which auto-switches the selected character's dark and light schemes. For another selected scheme, use <code>--adopt</code> or paste the printed snippet.</li>
          <li>Herdr apply enables theme auto-switch and writes per-mode <code>[theme.custom.dark]</code> / <code>[theme.custom.light]</code> overlays (needs a Herdr build with herdr#2324; not in a stable release yet). Unmarked <code>[theme]</code> sections stay unless you use <code>--adopt</code>. After applying, run <code>herdr server reload-config</code>.</li>
          <li>Claude Code has no host-appearance auto-switch for custom themes, so applying a sibling just pins that one theme, like Codex.</li>
          <li><code>install</code> remains a deprecated alias for <code>apply</code>.</li>
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const status = document.querySelector("[data-copy-status]");
    const copy = async (button, value, successMessage) => {
      if (!navigator.clipboard?.writeText) {
        if (status) status.textContent = "Copy unavailable";
        return;
      }
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = "COPIED ✓";
        if (status) status.textContent = successMessage;
        window.setTimeout(() => { button.textContent = button.dataset.originalLabel || "COPY"; }, 1600);
      } catch (error) {
        console.warn(`[sf2-themes] Clipboard write failed: ${error?.constructor?.name || "Error"}`);
        if (status) status.textContent = "Copy failed";
      }
    };
    for (const button of document.querySelectorAll("[data-install-copy], [data-install-command]")) {
      button.dataset.originalLabel = button.textContent;
      button.addEventListener("click", () => copy(button, button.dataset.installScript || button.dataset.installCommand, button.hasAttribute("data-install-copy") ? "Install script copied" : "Command copied"));
    }
  })();
</script>

<style>
  .install-page { padding-block-end: var(--space-20); }
  .install-hero { padding-block: var(--space-20) var(--space-12); }
  .install-eyebrow { margin: 0 0 var(--space-6); color: var(--ac); font: 600 var(--text-overline)/1.4 var(--font-mono); letter-spacing: 0.22em; }
  .install-lede { max-inline-size: 760px; margin: var(--space-8) 0 0; color: var(--mu); font-size: var(--text-body-lg); font-weight: 500; line-height: 1.5; text-wrap: pretty; }
  .install-content { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-16); min-inline-size: 0; }
  .install-section h2 { margin: 0 0 var(--space-6); font-family: var(--font-display); font-size: 34px; }
  .command-bar { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-6) var(--space-8); border: var(--border-thin) solid var(--ov); border-radius: 10px; background: var(--su); }
  .command-bar code { min-inline-size: 0; flex: 1; overflow-x: auto; color: var(--fg); font: 18px/1.6 var(--font-mono); white-space: nowrap; }
  .command-prompt { color: var(--se); }
  .command-bar button, .install-step button { flex: none; min-block-size: 44px; padding: var(--space-2) var(--space-4); border: var(--border-thin) solid var(--ov); border-radius: var(--radius-control); background: transparent; color: var(--ac); font: 600 13px/1.4 var(--font-mono); letter-spacing: 0.08em; cursor: pointer; }
  .command-bar button:hover, .install-step button:hover { border-color: var(--ac); }
  .install-muted, .install-status { margin: var(--space-3) 0 0; color: var(--mu); font-size: 18px; line-height: 1.5; }
  .install-status { min-block-size: 1.5em; color: var(--ac); }
  .install-moves { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: var(--space-4); }
  .install-step { min-inline-size: 0; padding: var(--space-6) var(--space-8); border: var(--border-thin) solid var(--ov); border-radius: var(--radius-panel); }
  .install-step__meta { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-block-end: var(--space-4); color: var(--ac); font: 600 15px/1.4 var(--font-mono); letter-spacing: 0.16em; }
  .install-step code { display: block; overflow-x: auto; margin-block-end: var(--space-4); color: var(--fg); font: 16px/1.6 var(--font-mono); white-space: nowrap; }
  .install-step p { margin: 0; color: var(--mu); font-size: 18px; line-height: 1.5; }
  .install-notes ul { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); max-inline-size: 860px; margin: 0; padding-inline-start: var(--space-6); color: var(--mu); font-size: 20px; line-height: 1.7; }
  .install-notes li { min-inline-size: 0; }
  .install-notes code, .install-lede code { color: var(--ac); font-family: var(--font-mono); overflow-wrap: break-word; }
  @media (max-width: 640px) { .install-hero { padding-block: var(--space-12) var(--space-10); } .command-bar { align-items: stretch; flex-direction: column; padding: var(--space-5); } .command-bar button { inline-size: 100%; } .install-step { padding: var(--space-5); } .install-step__meta { letter-spacing: 0.1em; } .install-step code { font-size: 14px; } }
</style>
