---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { buildSiteThemeCss, siteThemeDeclarations } from "../data/site-theme.mjs";
import { themeFamilies } from "../data/theme-data.mjs";
import {
  CABINET_IMAGE_PATH,
  PRODUCT_DESCRIPTION,
  PRODUCT_NAME,
  absoluteUrl,
  canonicalUrl,
  productJsonLd,
} from "../lib/seo.mjs";
import "../styles/global.css";

type SiteThemeFamily = {
  readonly id: string;
  readonly light: { readonly siteTokens: Record<string, string | readonly string[]> };
};
const siteThemeFamilies = themeFamilies as SiteThemeFamily[];

const { description = PRODUCT_DESCRIPTION, noindex = false, title } = Astro.props;
const pageTitle = `${title} | ${PRODUCT_NAME}`;
const pageUrl = canonicalUrl(Astro.url.pathname);
const shareImage = absoluteUrl(CABINET_IMAGE_PATH);
const jsonLd = noindex ? "" : JSON.stringify(productJsonLd());
const mainFamily = siteThemeFamilies.find(({ id }: SiteThemeFamily) => id === "main");
if (mainFamily === undefined) throw new TypeError("site theme Main family is required");
const themeCss = buildSiteThemeCss(siteThemeFamilies);
const mainLightCss = siteThemeDeclarations(mainFamily.light.siteTokens);
const siteThemeStyles = `${themeCss}
html[data-site-color-scheme="dark"] { color-scheme: dark; }
html[data-site-color-scheme="light"] { color-scheme: light; }
@media (prefers-color-scheme: light) {
  html[data-site-theme-family="main"][data-site-theme-id="main"] { ${mainLightCss}; color-scheme: light; }
}`;
const validFamilies = JSON.stringify(siteThemeFamilies.map(({ id }: SiteThemeFamily) => id));
const siteThemeBootstrap = `(() => {
  const root = document.documentElement;
  const validFamilies = ${validFamilies};
  let storedFamily = null;
  try { storedFamily = window.localStorage.getItem("sf2-themes.site-theme-family.v1"); } catch {}
  const family = validFamilies.includes(storedFamily) ? storedFamily : "main";
  let scheme = "dark";
  try { scheme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"; } catch {}
  root.dataset.siteThemeFamily = family;
  root.dataset.siteThemeId = scheme === "light" ? family + "-light" : family;
  root.dataset.siteColorScheme = scheme;
})();`;
---

<!doctype html>
<html lang="en" data-site-theme-family="main" data-site-theme-id="main" data-site-color-scheme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href={CABINET_IMAGE_PATH} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:inline set:html={siteThemeStyles}></style>
    <script is:inline set:html={siteThemeBootstrap}></script>
    {noindex ? null : <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <SiteHeader currentPath={Astro.url.pathname} />
      <main id="main-content" tabindex="-1"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
