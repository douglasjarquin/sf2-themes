---
import SiteCommandPalette from "../components/SiteCommandPalette.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteThemeFamilies } from "../data/site-theme-data.mjs";
import {
  PRODUCT_DESCRIPTION,
  PRODUCT_NAME,
  canonicalUrl,
  productJsonLd,
} from "../lib/seo.mjs";
import "../styles/global.css";
import "../styles/site-chrome.css";

const { description = PRODUCT_DESCRIPTION, noindex = false, title } = Astro.props;
const pageTitle = `${title} | ${PRODUCT_NAME}`;
const pageUrl = canonicalUrl(Astro.url.pathname);
const jsonLd = noindex ? "" : JSON.stringify(productJsonLd());
const colorVariables = new Map();

const defaultFamily =
  siteThemeFamilies.find(({ id }) => id === "ryu") ?? siteThemeFamilies[0];
const defaultPalette = defaultFamily.dark;
const siteVariables = [
  ["--bg", defaultPalette.bg],
  ["--surface", defaultPalette.surface],
  ["--border", defaultPalette.border],
  ["--line", defaultPalette.border],
  ["--fg", defaultPalette.fg],
  ["--muted", defaultPalette.muted],
  ["--subtle", defaultPalette.subtle],
  ["--accent", defaultPalette.accent],
  ["--accent2", defaultPalette.accent2],
  ["--sel", defaultPalette.sel],
  ["--orange", defaultPalette.orange],
  ...defaultPalette.n.map((value, index) => [`--c${index}`, value]),
  ...defaultPalette.b.map((value, index) => [`--c${index + 8}`, value]),
];
for (const [property, value] of siteVariables) colorVariables.set(property, value);

const customProperties = [...colorVariables]
  .map(([property, value]) => `${property}: ${value}`)
  .join("; ");
const siteThemePayload = JSON.stringify({ families: siteThemeFamilies })
  .replaceAll("<", "\\u003c")
  .replaceAll("\u2028", "\\u2028")
  .replaceAll("\u2029", "\\u2029");
---

<!doctype html>
<html
  lang="en"
  style={customProperties}
  data-theme={defaultFamily.id}
  data-mode="dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/json" id="site-theme-data" set:html={siteThemePayload} />
    <script is:inline>
      (() => {
        const data = document.getElementById("site-theme-data");
        if (!data) return;
        let payload;
        try { payload = JSON.parse(data.textContent || "null"); } catch { return; }
        const families = payload && payload.families;
        const isColor = (value) => typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
        const validVariant = (variant) => variant
          && typeof variant.id === "string"
          && isColor(variant.bg)
          && isColor(variant.surface)
          && isColor(variant.border)
          && isColor(variant.fg)
          && isColor(variant.muted)
          && isColor(variant.subtle)
          && isColor(variant.accent)
          && isColor(variant.accent2)
          && isColor(variant.sel)
          && isColor(variant.orange)
          && Array.isArray(variant.n) && variant.n.length === 8 && variant.n.every(isColor)
          && Array.isArray(variant.b) && variant.b.length === 8 && variant.b.every(isColor);
        if (!Array.isArray(families) || families.length === 0
          || !families.every((family) => family && typeof family.id === "string"
            && validVariant(family.dark) && validVariant(family.light))) return;
        const params = new URLSearchParams(location.search);
        const urlId = params.get("theme");
        const urlMode = params.get("mode");
        let saved = null;
        try {
          const candidate = JSON.parse(localStorage.getItem("sf2-site-theme") || "null");
          if (candidate && typeof candidate.id === "string") saved = candidate;
        } catch {}
        const id = urlId || (saved && saved.id) || "ryu";
        const mode = urlMode === "light" || urlMode === "dark"
          ? urlMode
          : saved && saved.mode === "light" ? "light" : "dark";
        const family = families.find((item) => item.id === id) || families.find((item) => item.id === "ryu") || families[0];
        const palette = family[mode];
        if (!palette) return;
        const root = document.documentElement;
        const values = {
          "--bg": palette.bg,
          "--surface": palette.surface,
          "--border": palette.border,
          "--line": palette.border,
          "--fg": palette.fg,
          "--muted": palette.muted,
          "--subtle": palette.subtle,
          "--accent": palette.accent,
          "--accent2": palette.accent2,
          "--sel": palette.sel,
          "--orange": palette.orange,
        };
        palette.n.forEach((color, index) => { values[`--c${index}`] = color; });
        palette.b.forEach((color, index) => { values[`--c${index + 8}`] = color; });
        Object.entries(values).forEach(([property, value]) => root.style.setProperty(property, value));
        root.style.colorScheme = mode;
        root.dataset.theme = family.id;
        root.dataset.mode = mode;
      })();
    </script>
    <title>{pageTitle}</title>
    {noindex ? null : <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main-content" tabindex="-1"><slot /></main>
      <SiteFooter />
    </div>
    <SiteCommandPalette />
    <script>
      import "../scripts/site-theme.mjs";
    </script>
  </body>
</html>
