---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { characterVariants, themeTokens } from "../data/theme-data.mjs";
import {
  CABINET_IMAGE_PATH,
  PRODUCT_DESCRIPTION,
  PRODUCT_NAME,
  absoluteUrl,
  canonicalUrl,
  productJsonLd,
} from "../lib/seo.mjs";
import "../styles/global.css";

const { description = PRODUCT_DESCRIPTION, noindex = false, title } = Astro.props;
const pageTitle = `${title} | ${PRODUCT_NAME}`;
const pageUrl = canonicalUrl(Astro.url.pathname);
const shareImage = absoluteUrl(CABINET_IMAGE_PATH);
const jsonLd = noindex ? "" : JSON.stringify(productJsonLd());
const main = themeTokens.main;
const colorVariables = new Map([
  ["--color-background", main.ui.background],
  ["--color-foreground", main.ui.foreground],
  ["--color-accent", main.ui.accent],
  ["--color-red", main.semantic.red],
  ["--color-cyan", main.semantic.cyan],
  ["--color-surface-dim", main.ui.surface_dim],
  ["--color-surface-0", main.ui.surface0],
  ["--color-surface-1", main.ui.surface1],
  ["--color-panel", main.ui.panel_bg],
]);

for (const variant of characterVariants) {
  for (const [role, value] of Object.entries(variant.colors)) {
    colorVariables.set(`--character-${variant.id}-${role}`, value);
  }
}

const customProperties = [...colorVariables]
  .map(([property, value]) => `${property}: ${value}`)
  .join("; ");
---

<!doctype html>
<html lang="en" style={customProperties}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href={CABINET_IMAGE_PATH} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {noindex ? null : <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <SiteHeader currentPath={Astro.url.pathname} />
      <main id="main-content" tabindex="-1"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
