---
import { siteThemeFamilies } from "../data/site-theme-data.mjs";
import { REPOSITORY_URL } from "../lib/seo.mjs";
import { sitePath } from "../lib/site-path.mjs";
---

<header class="site-header">
  <div class="site-header__group">
    <a class="site-brand" href={sitePath()}>sf2-themes</a>
    <nav class="site-nav" aria-label="Primary">
      <a href={`${sitePath()}#install`}>install</a>
      <a href={`${sitePath()}#ports`}>ports</a>
      <a href={REPOSITORY_URL} rel="noreferrer" target="_blank">github <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <div class="site-header__controls">
    <select class="site-select" data-site-select aria-label="Fighter theme">
      {siteThemeFamilies.map((family) => (
        <option value={family.id} selected={family.id === "ryu"}>{family.name}</option>
      ))}
    </select>
    <div class="site-modes" role="group" aria-label="Color mode">
      <button type="button" data-site-mode="dark" aria-pressed="true">dark</button>
      <button type="button" data-site-mode="light" aria-pressed="false">light</button>
    </div>
    <button class="site-cmdk" type="button" data-palette-trigger aria-label="Open theme palette" aria-haspopup="dialog" aria-expanded="false">⌘K</button>
  </div>
</header>
