---
import { paletteVariants } from "../data/theme-data.mjs";

type PreviewVariant = (typeof paletteVariants)[number];
type SyntaxTokenKind = "comment" | "keyword" | "number" | "plain" | "property" | "punctuation" | "string";
type SyntaxToken = {
  readonly kind: SyntaxTokenKind;
  readonly text: string;
};
type Swatch = {
  readonly group: "accent" | "bright" | "neutral" | "normal";
  readonly label: string;
  readonly token: string;
  readonly value: string;
};

const ansiRoles = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"] as const;
const initialPalette = paletteVariants[0];

function codeLines(variant: PreviewVariant): readonly string[] {
  return [
    "const theme = {",
    `  id: \"${variant.id}\",`,
    `  mode: \"${variant.tokens.meta.variant}\",`,
    "  ui: {",
    `    background: \"${variant.tokens.ui.background}\",`,
    `    foreground: \"${variant.tokens.ui.foreground}\",`,
    `    accent: \"${variant.tokens.ui.accent}\",`,
    "  },",
    "} as const;",
  ];
}

const syntaxPattern = /\/\/.*$|"(?:\\.|[^"])*"|\b(?:const|as)\b|\b(?:id|mode|ui|background|foreground|accent)(?=\s*:)|\b\d+(?:\.\d+)?\b|[{}(),:.;]/g;

function highlightCodeLine(line: string): readonly SyntaxToken[] {
  const tokens: SyntaxToken[] = [];
  let cursor = 0;
  for (const match of line.matchAll(syntaxPattern)) {
    const index = match.index ?? 0;
    if (index > cursor) tokens.push({ kind: "plain", text: line.slice(cursor, index) });
    const text = match[0];
    let kind: SyntaxTokenKind = "punctuation";
    if (text.startsWith("//")) kind = "comment";
    else if (text.startsWith("\"")) kind = "string";
    else if (/^(const|as)$/.test(text)) kind = "keyword";
    else if (/^(id|mode|ui|background|foreground|accent)$/.test(text)) kind = "property";
    else if (/^\d/.test(text)) kind = "number";
    tokens.push({ kind, text });
    cursor = index + text.length;
  }
  if (cursor < line.length) tokens.push({ kind: "plain", text: line.slice(cursor) });
  return tokens;
}

function terminalLines(variant: PreviewVariant): readonly string[] {
  return [
    `$ sf2-themes show ${variant.id}`,
    `theme       ${variant.id}`,
    `mode        ${variant.tokens.meta.variant}`,
    `background  ${variant.tokens.ui.background}`,
    `foreground  ${variant.tokens.ui.foreground}`,
    `accent      ${variant.tokens.ui.accent}`,
    `ansi.white  ${variant.tokens.ansi.normal.white}`,
  ];
}

function swatches(variant: PreviewVariant): readonly Swatch[] {
  return [
    { group: "neutral", label: "BACKGROUND", token: "ui.background", value: variant.tokens.ui.background },
    { group: "neutral", label: "SURFACE DIM", token: "ui.surface_dim", value: variant.tokens.ui.surface_dim },
    { group: "neutral", label: "SURFACE", token: "ui.surface", value: variant.tokens.ui.surface },
    { group: "neutral", label: "OVERLAY", token: "ui.overlay", value: variant.tokens.ui.overlay },
    { group: "neutral", label: "MUTED", token: "ui.muted", value: variant.tokens.ui.muted },
    { group: "neutral", label: "FOREGROUND", token: "ui.foreground", value: variant.tokens.ui.foreground },
    { group: "accent", label: "ACCENT", token: "ui.accent", value: variant.tokens.ui.accent },
    { group: "accent", label: "SECONDARY", token: "ui.accent_secondary", value: variant.tokens.ui.accent_secondary },
    { group: "accent", label: "YELLOW", token: "semantic.yellow", value: variant.tokens.semantic.yellow },
    ...ansiRoles.map((role) => ({
      group: "normal" as const,
      label: role.toUpperCase(),
      token: `ansi.normal.${role}`,
      value: variant.tokens.ansi.normal[role],
    })),
    ...ansiRoles.map((role) => ({
      group: "bright" as const,
      label: `BR ${role.toUpperCase()}`,
      token: `ansi.bright.${role}`,
      value: variant.tokens.ansi.bright[role],
    })),
  ];
}

function previewStyle(variant: PreviewVariant): string {
  return [
    ["--preview-bg", variant.tokens.ui.background],
    ["--preview-surface", variant.tokens.ui.surface],
    ["--preview-overlay", variant.tokens.ui.overlay],
    ["--preview-border", variant.tokens.ui.border],
    ["--preview-fg", variant.tokens.ui.foreground],
    ["--preview-muted", variant.tokens.ui.muted],
    ["--preview-subtle", variant.tokens.ui.subtle],
    ["--preview-accent", variant.tokens.ui.accent],
    ["--preview-secondary", variant.tokens.ui.accent_secondary],
    ["--preview-code-keyword", variant.tokens.semantic.magenta],
    ["--preview-code-property", variant.tokens.ui.accent],
    ["--preview-code-string", variant.tokens.semantic.green],
    ["--preview-code-number", variant.tokens.semantic.yellow],
    ["--preview-code-comment", variant.tokens.ui.subtle],
    ["--preview-code-punctuation", variant.tokens.ui.muted],
  ]
    .map(([property, value]) => `${property}: ${value}`)
    .join("; ");
}

const previewPayload = JSON.stringify(paletteVariants)
  .replaceAll("<", "\\u003c")
  .replaceAll("\u2028", "\\u2028")
  .replaceAll("\u2029", "\\u2029");

const initialSwatches = swatches(initialPalette);
---

<article
  aria-label={`Featured palette: ${initialPalette.name}`}
  class="featured-preview"
  data-featured-palette-preview
  data-selected-palette={initialPalette.id}
  style={previewStyle(initialPalette)}
>
  <header class="featured-preview__header">
    <div>
      <p>FEATURED PALETTE / <span data-preview-mode>{initialPalette.tokens.meta.variant.toUpperCase()}</span></p>
      <h2 data-preview-name>{initialPalette.name}</h2>
    </div>
    <code data-preview-id>{initialPalette.id}</code>
  </header>

  <div class="featured-preview__panes">
    <section class="featured-preview__pane featured-preview__pane--code" data-code-pane>
      <h3><span data-preview-id>{initialPalette.id}</span>/preview.ts</h3>
      <ol class="featured-preview__code-lines" data-code-content>
        {codeLines(initialPalette).map((line, lineIndex) => (
          <li>
            <span aria-hidden="true">{String(lineIndex + 1).padStart(2, "0")}</span>
            <code>
              {highlightCodeLine(line).map((token) => (
                <span class={`syntax-token syntax-token--${token.kind}`} data-syntax-kind={token.kind} data-syntax-token>{token.text}</span>
              ))}
            </code>
          </li>
        ))}
      </ol>
    </section>
    <section class="featured-preview__pane featured-preview__pane--terminal" data-terminal-pane>
      <h3>TERMINAL / <span data-preview-id>{initialPalette.id}</span></h3>
      <pre><code data-terminal-content>{terminalLines(initialPalette).join("\n")}</code></pre>
    </section>
  </div>

  <div class="featured-preview__ramps">
    {
      (["neutral", "accent", "normal", "bright"] as const).map((group) => (
        <section class:list={["featured-preview__ramp", `featured-preview__ramp--${group}`]}>
          <h3>{group === "neutral" ? "NEUTRALS" : group === "accent" ? "ACCENTS" : group === "normal" ? "ANSI" : "ANSI BRIGHT"}</h3>
          <div class="featured-preview__swatches">
            {initialSwatches.filter((swatch) => swatch.group === group).map((swatch) => (
              <div
                aria-label={`${swatch.label} ${swatch.value}`}
                class="featured-preview__swatch"
                data-preview-swatch
                data-swatch-group={swatch.group}
                data-swatch-token={swatch.token}
                style={`--swatch: ${swatch.value}`}
              >
                <span aria-hidden="true"></span>
                <strong data-swatch-label>{swatch.label}</strong>
                <code data-swatch-value>{swatch.value}</code>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</article>

<script is:inline type="application/json" data-featured-palette-data set:html={previewPayload}></script>
<script is:inline>
  (() => {
    const script = document.currentScript;
    const dataNode = script?.previousElementSibling;
    const currentPreview = dataNode?.previousElementSibling;
    if (!(dataNode instanceof HTMLScriptElement) || !dataNode.matches("[data-featured-palette-data]")) return;
    if (!(currentPreview instanceof HTMLElement) || !currentPreview.matches("[data-featured-palette-preview]")) return;

    try {
      const palettes = JSON.parse(dataNode.textContent ?? "");
      if (!Array.isArray(palettes) || palettes.length === 0) return;
      const palette = palettes[Math.floor(Math.random() * palettes.length)];
      if (!palette?.tokens?.ui || !palette?.tokens?.ansi || !palette?.tokens?.semantic) return;

      const nextPreview = currentPreview.cloneNode(true);
      if (!(nextPreview instanceof HTMLElement)) return;
      const ansiRoles = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"];
      const nextSwatches = [
        ["neutral", "BACKGROUND", "ui.background", palette.tokens.ui.background],
        ["neutral", "SURFACE DIM", "ui.surface_dim", palette.tokens.ui.surface_dim],
        ["neutral", "SURFACE", "ui.surface", palette.tokens.ui.surface],
        ["neutral", "OVERLAY", "ui.overlay", palette.tokens.ui.overlay],
        ["neutral", "MUTED", "ui.muted", palette.tokens.ui.muted],
        ["neutral", "FOREGROUND", "ui.foreground", palette.tokens.ui.foreground],
        ["accent", "ACCENT", "ui.accent", palette.tokens.ui.accent],
        ["accent", "SECONDARY", "ui.accent_secondary", palette.tokens.ui.accent_secondary],
        ["accent", "YELLOW", "semantic.yellow", palette.tokens.semantic.yellow],
        ...ansiRoles.map((role) => ["normal", role.toUpperCase(), `ansi.normal.${role}`, palette.tokens.ansi.normal[role]]),
        ...ansiRoles.map((role) => ["bright", `BR ${role.toUpperCase()}`, `ansi.bright.${role}`, palette.tokens.ansi.bright[role]]),
      ];
      const code = [
        "const theme = {",
        `  id: \"${palette.id}\",`,
        `  mode: \"${palette.tokens.meta.variant}\",`,
        "  ui: {",
        `    background: \"${palette.tokens.ui.background}\",`,
        `    foreground: \"${palette.tokens.ui.foreground}\",`,
        `    accent: \"${palette.tokens.ui.accent}\",`,
        "  },",
        "} as const;",
      ];
      const terminal = [
        `$ sf2-themes show ${palette.id}`,
        `theme       ${palette.id}`,
        `mode        ${palette.tokens.meta.variant}`,
        `background  ${palette.tokens.ui.background}`,
        `foreground  ${palette.tokens.ui.foreground}`,
        `accent      ${palette.tokens.ui.accent}`,
        `ansi.white  ${palette.tokens.ansi.normal.white}`,
      ];

      const syntaxPattern = /\/\/.*$|"(?:\\.|[^"])*"|\b(?:const|as)\b|\b(?:id|mode|ui|background|foreground|accent)(?=\s*:)|\b\d+(?:\.\d+)?\b|[{}(),:.;]/g;
      const highlightCodeLine = (line) => {
        const tokens = [];
        let cursor = 0;
        for (const match of line.matchAll(syntaxPattern)) {
          const index = match.index ?? 0;
          if (index > cursor) tokens.push(["plain", line.slice(cursor, index)]);
          const text = match[0];
          let kind = "punctuation";
          if (text.startsWith("//")) kind = "comment";
          else if (text.startsWith("\"")) kind = "string";
          else if (/^(const|as)$/.test(text)) kind = "keyword";
          else if (/^(id|mode|ui|background|foreground|accent)$/.test(text)) kind = "property";
          else if (/^\d/.test(text)) kind = "number";
          tokens.push([kind, text]);
          cursor = index + text.length;
        }
        if (cursor < line.length) tokens.push(["plain", line.slice(cursor)]);
        return tokens;
      };

      const renderCode = (codeContent, lines) => {
        codeContent.replaceChildren();
        lines.forEach((line, lineIndex) => {
          const lineNode = document.createElement("li");
          const numberNode = document.createElement("span");
          numberNode.setAttribute("aria-hidden", "true");
          numberNode.textContent = String(lineIndex + 1).padStart(2, "0");
          lineNode.append(numberNode);
          const textNode = document.createElement("code");
          for (const [kind, text] of highlightCodeLine(line)) {
            const tokenNode = document.createElement("span");
            tokenNode.className = `syntax-token syntax-token--${kind}`;
            tokenNode.dataset.syntaxKind = kind;
            tokenNode.dataset.syntaxToken = "";
            tokenNode.textContent = text;
            textNode.append(tokenNode);
          }
          lineNode.append(textNode);
          codeContent.append(lineNode);
        });
      };

      nextPreview.dataset.selectedPalette = palette.id;
      nextPreview.setAttribute("aria-label", `Featured palette: ${palette.name}`);
      for (const [property, value] of [
        ["--preview-bg", palette.tokens.ui.background],
        ["--preview-surface", palette.tokens.ui.surface],
        ["--preview-overlay", palette.tokens.ui.overlay],
        ["--preview-border", palette.tokens.ui.border],
        ["--preview-fg", palette.tokens.ui.foreground],
        ["--preview-muted", palette.tokens.ui.muted],
        ["--preview-subtle", palette.tokens.ui.subtle],
        ["--preview-accent", palette.tokens.ui.accent],
        ["--preview-secondary", palette.tokens.ui.accent_secondary],
        ["--preview-code-keyword", palette.tokens.semantic.magenta],
        ["--preview-code-property", palette.tokens.ui.accent],
        ["--preview-code-string", palette.tokens.semantic.green],
        ["--preview-code-number", palette.tokens.semantic.yellow],
        ["--preview-code-comment", palette.tokens.ui.subtle],
        ["--preview-code-punctuation", palette.tokens.ui.muted],
      ]) nextPreview.style.setProperty(property, value);
      for (const node of nextPreview.querySelectorAll("[data-preview-id]")) node.textContent = palette.id;
      const name = nextPreview.querySelector("[data-preview-name]");
      const mode = nextPreview.querySelector("[data-preview-mode]");
      const codeContent = nextPreview.querySelector("[data-code-content]");
      const terminalContent = nextPreview.querySelector("[data-terminal-content]");
      if (name) name.textContent = palette.name;
      if (mode) mode.textContent = palette.tokens.meta.variant.toUpperCase();
      if (codeContent instanceof HTMLElement) renderCode(codeContent, code);
      if (terminalContent) terminalContent.textContent = terminal.join("\n");

      const swatchNodes = nextPreview.querySelectorAll("[data-preview-swatch]");
      if (swatchNodes.length !== nextSwatches.length) return;
      swatchNodes.forEach((node, index) => {
        if (!(node instanceof HTMLElement)) return;
        const [group, label, token, value] = nextSwatches[index];
        node.dataset.swatchGroup = group;
        node.dataset.swatchToken = token;
        node.style.setProperty("--swatch", value);
        node.setAttribute("aria-label", `${label} ${value}`);
        const labelNode = node.querySelector("[data-swatch-label]");
        const valueNode = node.querySelector("[data-swatch-value]");
        if (labelNode) labelNode.textContent = label;
        if (valueNode) valueNode.textContent = value;
      });

      currentPreview.replaceWith(nextPreview);
    } catch {
      // The complete static palette remains visible when serialized data cannot be read.
    }
  })();
</script>

<style>
  .featured-preview { min-inline-size: 0; overflow: hidden; border: var(--border-thin) solid var(--preview-border); border-radius: var(--radius-panel); background: var(--preview-bg); color: var(--preview-fg); box-shadow: var(--shadow-card) var(--shadow-card) 0 var(--preview-overlay); }
  .featured-preview__header { display: flex; align-items: start; justify-content: space-between; gap: var(--space-3); padding: var(--space-4); border-block-end: var(--border-thin) solid var(--preview-overlay); }
  .featured-preview__header p, .featured-preview__header h2 { margin: 0; }
  .featured-preview__header p { color: var(--preview-subtle); font: 700 var(--text-overline)/1.8 var(--font-mono); letter-spacing: .12em; }
  .featured-preview__header h2 { margin-block-start: var(--space-1); color: var(--preview-fg); font: 700 var(--text-body-lg)/1.3 var(--font-body); text-shadow: none; }
  .featured-preview__header > code { flex: none; color: var(--preview-subtle); font: var(--text-caption)/1.5 var(--font-mono); }
  .featured-preview__panes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); padding: var(--space-3); }
  .featured-preview__pane { min-inline-size: 0; overflow: hidden; border: var(--border-thin) solid var(--preview-overlay); border-radius: var(--radius-control); background: var(--preview-surface); }
  .featured-preview__pane h3 { margin: 0; padding: var(--space-2); border-block-end: var(--border-thin) solid var(--preview-overlay); color: var(--preview-subtle); font: var(--text-label)/1.5 var(--font-mono); letter-spacing: .06em; }
  .featured-preview__code-lines { display: grid; gap: 0; margin: 0; padding: var(--space-2); background: color-mix(in srgb, var(--preview-surface) 70%, var(--preview-bg)); color: var(--preview-fg); font: var(--text-caption)/1.75 var(--font-mono); list-style: none; }
  .featured-preview__code-lines :global(li) { display: grid; grid-template-columns: var(--code-line-number-width) minmax(0, 1fr); gap: var(--space-2); min-inline-size: 0; }
  .featured-preview__code-lines :global(li > span) { color: var(--preview-subtle); opacity: .7; }
  .featured-preview__code-lines :global(code) { min-inline-size: 0; overflow-wrap: anywhere; white-space: pre-wrap; color: var(--preview-secondary); }
  :global(.syntax-token--keyword) { color: var(--preview-code-keyword); }
  :global(.syntax-token--property) { color: var(--preview-code-property); }
  :global(.syntax-token--string) { color: var(--preview-code-string); }
  :global(.syntax-token--number) { color: var(--preview-code-number); }
  :global(.syntax-token--comment) { color: var(--preview-code-comment); }
  :global(.syntax-token--punctuation) { color: var(--preview-code-punctuation); }
  :global(.syntax-token--plain) { color: inherit; }
  .featured-preview__pane--terminal code { color: var(--preview-accent); }
  .featured-preview__ramps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); padding: 0 var(--space-3) var(--space-3); }
  .featured-preview__ramp { min-inline-size: 0; }
  .featured-preview__ramp h3 { margin: 0 0 var(--space-2); color: var(--preview-subtle); font: var(--text-label)/1.5 var(--font-mono); letter-spacing: .12em; }
  .featured-preview__swatches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .featured-preview__ramp--normal .featured-preview__swatches, .featured-preview__ramp--bright .featured-preview__swatches { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .featured-preview__swatch { display: grid; min-inline-size: 0; gap: var(--space-1); }
  .featured-preview__swatch > span { display: block; block-size: var(--space-5); border: var(--border-thin) solid var(--preview-overlay); border-radius: var(--radius-swatch); background: var(--swatch); }
  .featured-preview__swatch strong, .featured-preview__swatch code { min-inline-size: 0; overflow-wrap: anywhere; font-family: var(--font-mono); line-height: 1.4; }
  .featured-preview__swatch strong { color: var(--preview-fg); font-size: var(--text-overline); }
  .featured-preview__swatch code { color: var(--preview-subtle); font-size: var(--text-caption); }
  @media (max-width: 980px) { .featured-preview__panes, .featured-preview__ramps { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .featured-preview__panes { grid-template-columns: repeat(2, minmax(0, 1fr)); } .featured-preview__ramps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .featured-preview__panes, .featured-preview__ramps { grid-template-columns: 1fr; } }
</style>
