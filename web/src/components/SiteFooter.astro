---
import { sitePath } from "../lib/site-path.mjs";

const pages = [
  { label: "Home", href: sitePath() },
  { label: "Themes", href: sitePath("themes") },
  { label: "Install", href: sitePath("install") },
];
---

<footer class="site-footer">
  <div class="site-frame site-footer__inner">
    <div class="site-footer__identity">
      <div class="site-footer__brand">SF2 THEMES</div>
      <p>
        A fan-made color palette for terminals. Not affiliated with or endorsed by
        Capcom. Street Fighter is a trademark of Capcom Co., Ltd.
      </p>
    </div>
    <nav class="site-footer__links" aria-label="Site">
      {
        pages.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <a
        href="https://github.com/douglasjarquin/sf2-themes"
        rel="noreferrer"
        target="_blank">GitHub <span aria-hidden="true">↗</span></a
      >
    </nav>
  </div>
</footer>
