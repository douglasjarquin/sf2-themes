---
import { DOCS_URL, LICENSE_URL, REPOSITORY_URL, llmsTxtLocation } from "../lib/seo.mjs";
---

<footer class="site-footer">
  <p class="site-footer__disclaimer">
    A fan-made color palette for terminals. Not affiliated with or endorsed by
    Capcom. Street Fighter is a trademark of Capcom Co., Ltd.
  </p>
  <nav class="site-footer__links" aria-label="Site">
    <a href={REPOSITORY_URL} rel="noreferrer" target="_blank">github <span aria-hidden="true">↗</span></a>
    <a href={`${REPOSITORY_URL}/issues`} rel="noreferrer" target="_blank">issues <span aria-hidden="true">↗</span></a>
    <a href={DOCS_URL} rel="noreferrer" target="_blank">docs <span aria-hidden="true">↗</span></a>
    <a href={LICENSE_URL} rel="license noreferrer" target="_blank">mit license <span aria-hidden="true">↗</span></a>
    <a href={llmsTxtLocation()}>llms.txt</a>
  </nav>
</footer>
