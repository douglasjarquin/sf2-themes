{
  "name": "sf2-theme-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "node --test tests/unit/*.test.mjs test/*.test.mjs",
    "test:game": "node --test test/game-core.test.mjs test/fighter-registry.test.mjs",
    "test:e2e": "playwright test",
    "test": "aubr test:unit && aubr test:e2e",
    "screenshots:game": "aubr build && node ../scripts/capture-game-screenshots.mjs",
    "screenshots:verify": "node ../scripts/verify-game-screenshots.mjs"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "textmode.js": "0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "astro": "7.2.6",
    "typescript": "5.9.3"
  }
}
