{
  "name": "sf2-theme-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "python3 ../mise-tasks/generate-web-theme-data --check && astro build",
    "preview": "astro preview",
    "check": "python3 ../mise-tasks/generate-web-theme-data --check && astro check",
    "test:unit": "python3 ../mise-tasks/generate-web-theme-data --check && node --test tests/unit/*.test.mjs test/*.test.mjs",
    "themes:generate": "python3 ../mise-tasks/generate-web-theme-data",
    "themes:check": "python3 ../mise-tasks/generate-web-theme-data --check",
    "test:game": "node --test test/game-core.test.mjs test/fighter-registry.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "textmode.js": "0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "25.2.3",
    "astro": "7.2.6",
    "typescript": "5.9.3"
  }
}
