[
 {
  "name": "absent-apply",
  "args": [
   "apply",
   "codex",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "absent"
  },
  "want": {
   "exit": 0,
   "stdout": "apply codex: sf2-main (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: 2 created\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-main\n",
    "themes/sf2-main.txt": "palette sf2-main\n"
   }
  }
 },
 {
  "name": "absent-setup",
  "args": [
   "setup",
   "codex",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "absent"
  },
  "want": {
   "exit": 0,
   "stdout": "setup codex: no selection found, selected sf2-main (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: 2 created\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-main\n",
    "themes/sf2-main.txt": "palette sf2-main\n"
   }
  }
 },
 {
  "name": "managed-setup-keeps",
  "args": [
   "setup",
   "codex",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "managed",
   "current": "ryu"
  },
  "seed": {
   "config.txt": "keep = 1\ntheme = sf2-ryu\n"
  },
  "want": {
   "exit": 0,
   "stdout": "setup codex: kept sf2-ryu (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: 1 created, 1 unchanged\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-ryu\n",
    "themes/sf2-ryu.txt": "palette sf2-ryu\n"
   }
  }
 },
 {
  "name": "all-unchanged",
  "args": [
   "apply",
   "codex",
   "--theme",
   "ken",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "managed",
   "current": "ken"
  },
  "seed": {
   "config.txt": "keep = 1\ntheme = sf2-ken\n",
   "themes/sf2-ken.txt": "palette sf2-ken\n"
  },
  "want": {
   "exit": 0,
   "stdout": "apply codex: sf2-ken (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: no changes\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-ken\n",
    "themes/sf2-ken.txt": "palette sf2-ken\n"
   }
  }
 },
 {
  "name": "verbose-every-outcome",
  "args": [
   "apply",
   "codex",
   "--theme",
   "ken",
   "--verbose",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "legacy",
   "current": "ryu"
  },
  "seed": {
   "config.txt": "keep = 1\ntheme = ryu\n",
   "themes/sf2-ken.txt": "palette sf2-ken\n",
   "legacy.txt": "old\n"
  },
  "want": {
   "exit": 0,
   "stdout": "unchanged: {DIR}/themes/sf2-ken.txt\nupdated: {DIR}/config.txt\n--- {DIR}/config.txt\n+++ {DIR}/config.txt\n@@ -1,2 +1,2 @@\n keep = 1\n-theme = ryu\n+theme = sf2-ken\nremoved: {DIR}/legacy.txt\napply codex: sf2-ken (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: 1 updated, 1 removed, 1 unchanged\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-ken\n",
    "config.txt.bak": "keep = 1\ntheme = ryu\n",
    "themes/sf2-ken.txt": "palette sf2-ken\n"
   }
  }
 },
 {
  "name": "dry-run",
  "args": [
   "apply",
   "codex",
   "--theme",
   "ken",
   "--dry-run",
   "--config-dir",
   "{DIR}"
  ],
  "inspection": {
   "ownership": "managed",
   "current": "ryu"
  },
  "seed": {
   "config.txt": "keep = 1\ntheme = sf2-ryu\n",
   "legacy.txt": "old\n"
  },
  "want": {
   "exit": 0,
   "stdout": "would create: {DIR}/themes/sf2-ken.txt\n--- /dev/null\n+++ {DIR}/themes/sf2-ken.txt\n@@ -0,0 +1 @@\n+palette sf2-ken\nwould update: {DIR}/config.txt\n--- {DIR}/config.txt\n+++ {DIR}/config.txt\n@@ -1,2 +1,2 @@\n keep = 1\n-theme = sf2-ryu\n+theme = sf2-ken\nwould remove: {DIR}/legacy.txt\napply codex: sf2-ken (fixed; does not follow host appearance)\n  target: {DIR}/config.txt\n  changes: 1 would create, 1 would update, 1 would remove\n  note: restart the stub\n",
   "stderr": "hint line\n\n",
   "files": {
    "config.txt": "keep = 1\ntheme = sf2-ryu\n",
    "legacy.txt": "old\n"
   }
  }
 },
 {
  "name": "foreign-apply-refuses",
  "args": [
   "apply",
   "codex",
   "--config-dir",
   "{DIR}"
  ],
